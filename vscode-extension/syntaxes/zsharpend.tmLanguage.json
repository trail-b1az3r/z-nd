{
  "scopeName": "source.zsharpend",
  "patterns": [
    { "include": "#comments" }, { "include": "#strings" },
    { "include": "#numbers" }, { "include": "#keywords" },
    { "include": "#types" }, { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": { "patterns": [
      { "name": "comment.line.double-slash.zsharpend", "match": "//.*$" },
      { "name": "comment.block.zsharpend", "begin": "/\\*", "end": "\\*/" }
    ]},
    "strings": { "patterns": [
      { "name": "string.quoted.double.zsharpend", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape", "match": "\\\\." }] },
      { "name": "string.quoted.single.zsharpend", "begin": "'", "end": "'" }
    ]},
    "numbers": { "patterns": [
      { "name": "constant.numeric.float.zsharpend", "match": "\\b\\d+\\.\\d+\\b" },
      { "name": "constant.numeric.integer.zsharpend", "match": "\\b\\d+\\b" }
    ]},
    "keywords": { "patterns": [
      { "name": "keyword.control.zsharpend", "match": "\\b(if|elif|else|while|for|in|not|break|continue|return|loop|match|case|switch)\\b" },
      { "name": "keyword.declaration.zsharpend", "match": "\\b(fn|let|mut|const|enum|trait|import|class|new|try|catch|throw|async|await)\\b" },
      { "name": "constant.language.zsharpend", "match": "\\b(None|true|false|True|False|Some|Ok|Err)\\b" }
    ]},
    "types": { "patterns": [
      { "name": "storage.type.zsharpend", "match": "\\b(U0|I8|I16|I32|I64|U8|U16|U32|U64|F32|F64|bool|str|string|int|float)\\b" }
    ]},
    "operators": { "patterns": [
      { "name": "keyword.operator.zsharpend", "match": "(==|!=|<=|>=|\\+|-|\\*|/|%|@|=|<|>|\\?|\\|\\|?|&&)" }
    ]},
    "functions": { "patterns": [
      { "name": "entity.name.function.zsharpend", "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()" }
    ]}
  }
}