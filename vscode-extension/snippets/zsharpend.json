{
  "Function": { "prefix": "fn", "body": ["fn ${1:name}(${2:args}) {", "\t${3}", "}"], "description": "Zsharpend function" },
  "Mutable variable": { "prefix": "mut", "body": ["let mut ${1:name} = ${2:value};"], "description": "Mutable variable" },
  "Match": { "prefix": "match", "body": ["match ${1:value} {", "\t${2:Variant} => ${3:result},", "}"], "description": "Pattern matching" },
  "Enum": { "prefix": "enum", "body": ["enum ${1:Name} {", "\t${2:Variant},", "}"], "description": "Enum declaration" },
  "If else": { "prefix": "if", "body": ["if ${1:condition} {", "\t${2}", "} else {", "\t${3}", "}"], "description": "Conditional" },
  "For loop": { "prefix": "for", "body": ["for ${1:item} in ${2:items} {", "\t${3}", "}"], "description": "For loop" },
  "Print": { "prefix": "print", "body": ["print(${1:value});"], "description": "Print value" },
  "Import module": { "prefix": "import", "body": ["import ${1:module};"], "description": "Import module" },
  "List comprehension": { "prefix": "comp", "body": ["[${1:expr} for ${2:item} in ${3:items}]"], "description": "List comprehension" }
}